{
  "name": "Settings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nombre de la empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "URL del logo"
    },
    "phone_1": {
      "type": "string",
      "description": "Tel\u00e9fono principal"
    },
    "phone_2": {
      "type": "string",
      "description": "Tel\u00e9fono secundario"
    },
    "whatsapp_message": {
      "type": "string",
      "description": "Mensaje pre-configurado de WhatsApp"
    },
    "instructions_pdf_url": {
      "type": "string",
      "description": "URL del PDF de instrucciones de uso"
    },
    "disinfection_pdf_url": {
      "type": "string",
      "description": "URL del PDF de instrucciones de desinfecci\u00f3n"
    },
    "vitrectomy_info": {
      "type": "string",
      "description": "Informaci\u00f3n sobre la vitrectom\u00eda"
    },
    "care_agreement_text": {
      "type": "string",
      "description": "Texto del compromiso de cuidado"
    },
    "monthly_membership_price": {
      "type": "number",
      "description": "Precio de membres\u00eda mensual para socios",
      "default": 500
    },
    "days_advance_outside_nl": {
      "type": "number",
      "description": "D\u00edas de anticipaci\u00f3n para env\u00edo fuera de NL",
      "default": 3
    },
    "service_states": {
      "type": "array",
      "description": "Estados donde hay servicio disponible",
      "items": {
        "type": "string"
      },
      "default": [
        "Nuevo Le\u00f3n"
      ]
    },
    "hero_title": {
      "type": "string",
      "description": "T\u00edtulo principal de la p\u00e1gina de inicio",
      "default": "Recuperaci\u00f3n Segura Post-Vitrectom\u00eda"
    },
    "hero_subtitle": {
      "type": "string",
      "description": "Subt\u00edtulo de la p\u00e1gina de inicio",
      "default": "Equipos de reposo especializados para tu recuperaci\u00f3n. Env\u00edo a toda la rep\u00fablica con instrucciones completas."
    },
    "hero_image_url": {
      "type": "string",
      "description": "URL de imagen de fondo del hero"
    },
    "primary_color": {
      "type": "string",
      "description": "Color primario del sitio (hex)",
      "default": "#0ea5e9"
    },
    "secondary_color": {
      "type": "string",
      "description": "Color secundario del sitio (hex)",
      "default": "#3b82f6"
    },
    "font_family": {
      "type": "string",
      "description": "Familia de fuente",
      "default": "system-ui"
    }
  },
  "required": [],
  "rls": {
    "read": true,
    "create": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}