{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "comment": {
      "type": "string",
      "description": "Comentario del cliente"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Calificaci\u00f3n de 1 a 5"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "Si el comentario est\u00e1 aprobado"
    },
    "equipment_name": {
      "type": "string",
      "description": "Equipo que rent\u00f3"
    }
  },
  "required": [
    "client_name",
    "comment",
    "rating"
  ],
  "rls": {
    "read": true,
    "create": true,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}